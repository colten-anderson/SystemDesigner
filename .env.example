# SystemDesigner voice interview — provider configuration.
# Copy to .env and fill in. Never commit a real .env.

# --- LLM (required for all modes) -------------------------------------------
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Default model; claude-sonnet-4-6 is ~40% cheaper with lower latency, and
# claude-haiku-4-5 is the budget option for rehearsals. (Also: --model flag.)
LLM_MODEL=claude-opus-4-8
# Cap on output tokens per turn (spoken turns are short; bounds runaway cost).
#LLM_MAX_TOKENS=1024

# --- Voice providers (required for --join / --local-audio) ------------------
# Speech-to-text: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Text-to-speech: https://play.cartesia.ai/
CARTESIA_API_KEY=
# Optional: pick a different Cartesia voice.
#CARTESIA_VOICE_ID=

# --- Telephony for --join: pick ONE provider --------------------------------
# daily (default) or twilio. Twilio is fully self-serve (no gated feature) but
# needs a public URL; Daily needs PSTN dial-out enabled on your domain.
#TELEPHONY_PROVIDER=daily

# Option A: Daily — https://dashboard.daily.co/ (domain needs PSTN dial-out
# enabled and a purchased phone number; contact Daily support to enable it).
DAILY_API_KEY=
#DAILY_API_URL=https://api.daily.co/v1

# Option B: Twilio — https://console.twilio.com/ (buy a number self-serve).
# Requires a publicly reachable URL for the call audio: `ngrok http 8765`
# and put the https URL in PUBLIC_URL. Install with: pip install -e ".[voice-twilio]"
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM_NUMBER=+1...
#PUBLIC_URL=https://your-tunnel.ngrok.app
#TWILIO_WS_PORT=8765

# --- Teams dial-out tuning (optional) ----------------------------------------
# Seconds to wait for the Teams IVR greeting before sending the conference ID.
#DTMF_INITIAL_DELAY_S=3.0
# Seconds before the trailing '#' (the "record your name or press #" prompt).
#DTMF_CONFIRM_DELAY_S=3.0
# Display name the bot uses.
#INTERVIEW_BOT_NAME=SystemDesigner Interviewer
